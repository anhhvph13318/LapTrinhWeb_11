@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">
    <div class="container" style="max-width: 420px; margin-top: 50px; margin-bottom: 50px;">

        <div class="card" id="loginCard">
            <div class="card-body">
                <h3 class="text-center mb-4">Đăng nhập</h3>
                <div id="loginSuccess" class="text-success mb-3"></div>
                <div class="mb-3">
                    <label class="form-label">Tên đăng nhập</label>
                    <input type="text" id="loginUsername" class="form-control" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Mật khẩu</label>
                    <input type="password" id="loginPassword" class="form-control" />
                </div>
                <div id="loginError" class="text-danger mb-3"></div>
                <button type="button" id="btnLogin" class="btn btn-primary w-100">Đăng nhập</button>
                <button type="button" id="btnShowRegister" class="btn btn-outline-success w-100 mt-2">Đăng ký tài khoản</button>
            </div>
        </div>

        <div class="card" id="registerCard" style="display: none;">
            <div class="card-body">
                <h3 class="text-center mb-4">Đăng ký tài khoản</h3>
                <div class="mb-3">
                    <label class="form-label">Tên đăng nhập</label>
                    <input type="text" id="regUsername" class="form-control" maxlength="50" autocomplete="off" />
                    <div class="form-text">3-50 ký tự: chữ không dấu, số, dấu chấm hoặc gạch dưới</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Mật khẩu</label>
                    <input type="password" id="regPassword" class="form-control" maxlength="50" autocomplete="new-password" />
                    <div class="form-text">6-50 ký tự</div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Nhập lại mật khẩu</label>
                    <input type="password" id="regConfirm" class="form-control" maxlength="50" autocomplete="new-password" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Họ tên</label>
                    <input type="text" id="regFullName" class="form-control" maxlength="100" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email (không bắt buộc)</label>
                    <input type="text" id="regEmail" class="form-control" maxlength="100" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Số điện thoại (không bắt buộc)</label>
                    <input type="text" id="regPhone" class="form-control" maxlength="20" />
                </div>
                <div id="registerError" class="text-danger mb-3"></div>
                <button type="button" id="btnRegister" class="btn btn-success w-100">Đăng ký</button>
                <button type="button" id="btnShowLogin" class="btn btn-outline-secondary w-100 mt-2">Quay lại đăng nhập</button>
            </div>
        </div>

    </div>

    <script>
        function showCard(name) {
            document.getElementById("loginCard").style.display = name == "login" ? "block" : "none";
            document.getElementById("registerCard").style.display = name == "register" ? "block" : "none";
        }

        async function login() {
            var username = document.getElementById("loginUsername").value;
            var password = document.getElementById("loginPassword").value;
            document.getElementById("loginSuccess").innerText = "";
            if (username == "" || password == "") {
                document.getElementById("loginError").innerText = "Vui lòng nhập đủ tên đăng nhập và mật khẩu";
                return;
            }
            var res = await fetch("/login", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ username: username, password: password })
            });
            if (res.ok) {
                var data = await res.json();
                window.location.href = data.redirect;
            } else {
                document.getElementById("loginError").innerText = await res.text();
            }
        }

        async function register() {
            var errorBox = document.getElementById("registerError");
            var username = document.getElementById("regUsername").value.trim();
            var password = document.getElementById("regPassword").value;
            var confirm = document.getElementById("regConfirm").value;
            var fullName = document.getElementById("regFullName").value.trim();
            var email = document.getElementById("regEmail").value.trim();
            var phone = document.getElementById("regPhone").value.trim();

            if (!/^[a-zA-Z0-9_.]{3,50}$/.test(username)) {
                errorBox.innerText = "Tên đăng nhập gồm 3-50 ký tự: chữ không dấu, số, dấu chấm hoặc gạch dưới";
                return;
            }
            if (password.length < 6 || password.length > 50) {
                errorBox.innerText = "Mật khẩu từ 6 đến 50 ký tự";
                return;
            }
            if (password != confirm) {
                errorBox.innerText = "Mật khẩu nhập lại không khớp";
                return;
            }
            if (fullName == "") {
                errorBox.innerText = "Họ tên không được để trống";
                return;
            }
            if (email != "" && !/^[^@@\s]+@@[^@@\s]+\.[^@@\s]+$/.test(email)) {
                errorBox.innerText = "Email không hợp lệ";
                return;
            }
            if (phone != "" && !/^\+?[0-9]{9,15}$/.test(phone)) {
                errorBox.innerText = "Số điện thoại không hợp lệ";
                return;
            }

            var btn = document.getElementById("btnRegister");
            btn.disabled = true;
            errorBox.innerText = "";
            try {
                var res = await fetch("/register", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ username: username, password: password, fullName: fullName, email: email, phone: phone })
                });
                if (res.ok) {
                    document.getElementById("loginUsername").value = username;
                    document.getElementById("loginPassword").value = "";
                    document.getElementById("loginError").innerText = "";
                    document.getElementById("loginSuccess").innerText = "Đăng ký thành công, vui lòng đăng nhập";
                    document.getElementById("regPassword").value = "";
                    document.getElementById("regConfirm").value = "";
                    showCard("login");
                } else {
                    errorBox.innerText = await res.text();
                }
            } finally {
                btn.disabled = false;
            }
        }

        document.getElementById("btnLogin").addEventListener("click", login);
        document.getElementById("btnRegister").addEventListener("click", register);
        document.getElementById("btnShowRegister").addEventListener("click", function () {
            document.getElementById("registerError").innerText = "";
            showCard("register");
        });
        document.getElementById("btnShowLogin").addEventListener("click", function () {
            document.getElementById("loginSuccess").innerText = "";
            showCard("login");
        });
        document.getElementById("loginCard").addEventListener("keydown", function (e) {
            if (e.key == "Enter") {
                login();
            }
        });
        document.getElementById("registerCard").addEventListener("keydown", function (e) {
            if (e.key == "Enter") {
                register();
            }
        });
    </script>
</body>
</html>
