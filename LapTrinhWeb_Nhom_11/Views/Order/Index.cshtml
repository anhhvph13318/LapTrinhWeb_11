@{
    ViewData["Title"] = "Quản lý hóa đơn";
    Layout = "_AdminLayout";
}

<h3 class="mb-3">Quản lý hóa đơn</h3>

<!-- bộ lọc -->
<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4">
                <label class="form-label small mb-1">Tìm kiếm</label>
                <input type="text" id="fKeyword" class="form-control" placeholder="Mã đơn, tên hoặc số điện thoại khách" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Trạng thái đơn</label>
                <select id="fStatus" class="form-select">
                    <option value="">Tất cả</option>
                    <option value="0">Chờ xác nhận</option>
                    <option value="1">Đã xác nhận</option>
                    <option value="2">Đang giao</option>
                    <option value="3">Hoàn thành</option>
                    <option value="4">Đã hủy</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Từ ngày</label>
                <input type="date" id="fFromDate" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label small mb-1">Đến ngày</label>
                <input type="date" id="fToDate" class="form-control" />
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="button" class="btn btn-primary me-1" onclick="loadData()">Lọc</button>
                <button type="button" class="btn btn-outline-secondary" onclick="resetFilter()">Đặt lại</button>
            </div>
        </div>
    </div>
</div>

<table class="table table-bordered align-middle">
    <thead>
        <tr>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th>Ngày đặt</th>
            <th>Số SP</th>
            <th>Tổng tiền</th>
            <th>Thanh toán</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody id="tbody"></tbody>
</table>

<!-- chi tiết hóa đơn -->
<div class="modal fade" id="orderModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Chi tiết hóa đơn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="modalBody"></div>
            <div class="modal-footer justify-content-between">
                <div id="actions"></div>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var orders = [];
        var currentOrder = null;
        var modal = new bootstrap.Modal(document.getElementById("orderModal"));

        // Trạng thái đơn: 0 Chờ xác nhận, 1 Đã xác nhận, 2 Đang giao, 3 Hoàn thành, 4 Hủy
        var statusNames = ["Chờ xác nhận", "Đã xác nhận", "Đang giao", "Hoàn thành", "Đã hủy"];
        var statusClasses = ["bg-warning text-dark", "bg-info text-dark", "bg-primary", "bg-success", "bg-danger"];
        // Phương thức thanh toán: 0 thanh toán khi nhận hàng, 1 chuyển khoản
        var paymentMethodNames = ["Thanh toán khi nhận hàng", "Chuyển khoản"];
        // Trạng thái thanh toán: 0 chưa thanh toán, 1 đã thanh toán
        var paymentStatusNames = ["Chưa thanh toán", "Đã thanh toán"];

        // Từ trạng thái hiện tại thì được chuyển sang những trạng thái nào (giống quy tắc trong OrderController)
        var nextActions = {
            0: [{ to: 1, text: "Xác nhận đơn", cls: "btn-primary" }, { to: 4, text: "Hủy đơn", cls: "btn-danger" }],
            1: [{ to: 2, text: "Bắt đầu giao hàng", cls: "btn-primary" }, { to: 4, text: "Hủy đơn", cls: "btn-danger" }],
            2: [{ to: 3, text: "Hoàn thành", cls: "btn-success" }, { to: 4, text: "Hủy đơn", cls: "btn-danger" }]
        };

        // chống lỗi hiển thị khi dữ liệu có ký tự đặc biệt
        function esc(text) {
            return String(text ?? "")
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }

        // nếu hết phiên đăng nhập thì về trang login
        function checkLogin(res) {
            if (res.status == 401) {
                window.location.href = "/login";
                return false;
            }
            return true;
        }

        function money(number) {
            return Number(number).toLocaleString("vi-VN") + " đ";
        }

        function dateText(text) {
            return new Date(text).toLocaleString("vi-VN");
        }

        function nameOf(list, index) {
            return list[index] ?? ("Khác (" + index + ")");
        }

        function statusBadge(status) {
            return "<span class='badge " + (statusClasses[status] ?? "bg-secondary") + "'>" + esc(nameOf(statusNames, status)) + "</span>";
        }

        function paymentStatusBadge(status) {
            var cls = status == 1 ? "bg-success" : "bg-secondary";
            return "<span class='badge " + cls + "'>" + esc(nameOf(paymentStatusNames, status)) + "</span>";
        }

        // ===== danh sách =====
        async function loadData() {
            var fromDate = document.getElementById("fFromDate").value;
            var toDate = document.getElementById("fToDate").value;
            if (fromDate != "" && toDate != "" && fromDate > toDate) {
                alert("Từ ngày không được lớn hơn đến ngày");
                return;
            }
            var params = new URLSearchParams();
            var keyword = document.getElementById("fKeyword").value.trim();
            var status = document.getElementById("fStatus").value;
            if (keyword != "") params.append("keyword", keyword);
            if (status != "") params.append("status", status);
            if (fromDate != "") params.append("fromDate", fromDate);
            if (toDate != "") params.append("toDate", toDate);

            var res = await fetch("/orders/admin?" + params.toString());
            if (!checkLogin(res)) {
                return;
            }
            orders = await res.json();
            render();
        }

        function resetFilter() {
            document.getElementById("fKeyword").value = "";
            document.getElementById("fStatus").value = "";
            document.getElementById("fFromDate").value = "";
            document.getElementById("fToDate").value = "";
            loadData();
        }

        function render() {
            var html = "";
            if (orders.length == 0) {
                html = "<tr><td colspan='8' class='text-center text-muted'>Không có hóa đơn nào</td></tr>";
            }
            orders.forEach(function (o) {
                html += "<tr>";
                html += "<td><b>" + esc(o.orderCode) + "</b></td>";
                html += "<td>" + esc(o.customerName) + "<div class='small text-muted'>" + esc(o.phone) + "</div></td>";
                html += "<td>" + dateText(o.createdAt) + "</td>";
                html += "<td>" + o.itemCount + "</td>";
                html += "<td>" + money(o.totalAmount) + "</td>";
                html += "<td>" + esc(nameOf(paymentMethodNames, o.paymentMethod)) + "<div>" + paymentStatusBadge(o.paymentStatus) + "</div></td>";
                html += "<td>" + statusBadge(o.status) + "</td>";
                html += "<td><button class='btn btn-sm btn-primary' onclick='openDetail(" + o.id + ")'>Xem chi tiết</button></td>";
                html += "</tr>";
            });
            document.getElementById("tbody").innerHTML = html;
        }

        // ===== chi tiết =====
        async function openDetail(id) {
            var res = await fetch("/orders/admin/" + id);
            if (!checkLogin(res)) {
                return;
            }
            if (!res.ok) {
                alert(await res.text());
                return;
            }
            var o = await res.json();
            currentOrder = o;
            document.getElementById("modalTitle").innerText = "Hóa đơn " + o.orderCode;

            var html = "";
            html += "<div class='row mb-3'>";
            html += "<div class='col-md-6'>";
            html += "<p class='mb-1'><b>Khách hàng:</b> " + esc(o.customerName) + "</p>";
            html += "<p class='mb-1'><b>Số điện thoại:</b> " + esc(o.phone) + "</p>";
            html += "<p class='mb-1'><b>Địa chỉ:</b> " + esc(o.address) + "</p>";
            html += "<p class='mb-1'><b>Ghi chú:</b> " + esc(o.note ?? "") + "</p>";
            html += "</div>";
            html += "<div class='col-md-6'>";
            html += "<p class='mb-1'><b>Ngày đặt:</b> " + dateText(o.createdAt) + "</p>";
            html += "<p class='mb-1'><b>Thanh toán:</b> " + esc(nameOf(paymentMethodNames, o.paymentMethod)) + " " + paymentStatusBadge(o.paymentStatus) + "</p>";
            html += "<p class='mb-1'><b>Mã vận đơn:</b> " + esc(o.trackingCode ?? "Chưa có") + "</p>";
            html += "<p class='mb-1'><b>Trạng thái:</b> " + statusBadge(o.status) + "</p>";
            html += "</div>";
            html += "</div>";

            html += "<table class='table table-bordered align-middle'>";
            html += "<thead><tr><th>Ảnh</th><th>Sản phẩm</th><th>Size / Màu</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>";
            o.items.forEach(function (item) {
                var thumb = item.imageUrl
                    ? "<img src='" + esc(item.imageUrl) + "' style='width:50px;height:50px;object-fit:cover;' />"
                    : "";
                html += "<tr>";
                html += "<td>" + thumb + "</td>";
                html += "<td>" + esc(item.productName) + "<div class='small text-muted'>" + esc(item.productCode) + "</div></td>";
                html += "<td>" + esc(item.sizeName) + " / " + esc(item.colorName) + "</td>";
                html += "<td>" + item.quantity + "</td>";
                html += "<td>" + money(item.price) + "</td>";
                html += "<td>" + money(item.price * item.quantity) + "</td>";
                html += "</tr>";
            });
            html += "</tbody></table>";
            html += "<h5 class='text-end'>Tổng tiền: " + money(o.totalAmount) + "</h5>";
            document.getElementById("modalBody").innerHTML = html;

            // các nút đổi trạng thái (đơn hoàn thành hoặc đã hủy thì không còn nút nào)
            var actions = nextActions[o.status] ?? [];
            var actionHtml = "";
            actions.forEach(function (a) {
                actionHtml += "<button type='button' class='btn " + a.cls + " me-2' onclick='changeStatus(" + a.to + ")'>" + a.text + "</button>";
            });
            if (actions.length == 0) {
                actionHtml = "<span class='text-muted'>Đơn hàng đã kết thúc, không thể đổi trạng thái</span>";
            }
            document.getElementById("actions").innerHTML = actionHtml;
            modal.show();
        }

        async function changeStatus(to) {
            var question = to == 4
                ? "Bạn có chắc muốn HỦY hóa đơn này? Hóa đơn đã hủy không thể đổi lại."
                : "Chuyển hóa đơn sang trạng thái \"" + statusNames[to] + "\"?";
            if (!confirm(question)) {
                return;
            }
            var res = await fetch("/orders/status/" + currentOrder.id, {
                method: "PUT",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ status: to })
            });
            if (!checkLogin(res)) {
                return;
            }
            if (res.ok) {
                await loadData();
                openDetail(currentOrder.id); // tải lại chi tiết để thấy trạng thái mới
            } else {
                alert(await res.text());
            }
        }

        // bấm Enter ở ô tìm kiếm thì lọc luôn
        document.getElementById("fKeyword").addEventListener("keydown", function (e) {
            if (e.key == "Enter") {
                loadData();
            }
        });

        loadData();
    </script>
}
